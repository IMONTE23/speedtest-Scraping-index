{
  "manifest_version": 3,
  "name": "Speedtest Global Index Scraper",
  "version": "1.2.0",
  "description": "Fast 1-click Country & City rankings scraper and 4-sheet Excel exporter for Speedtest Global Index.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.speedtest.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
